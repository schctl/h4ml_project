    <mxCell id="rs" value="Resample to 4 kHz&lt;br&gt;cut into 256 ms windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="host">
