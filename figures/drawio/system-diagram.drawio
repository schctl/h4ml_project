    <mxCell id="ft" value="Feature extraction&lt;br&gt;FFT, log, 64 bands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="nano">
      <mxGeometry x="210" y="45" width="150" height="60" as="geometry"/>
