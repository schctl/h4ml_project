<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="host" value="Desktop PC (training + test harness)" style="swimlane;html=1;startSize=24;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="760" height="130" as="geometry"/>
