    <mxCell id="ml" value="MLP inference&lt;br&gt;float32 and int8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="nano">
      <mxGeometry x="20" y="45" width="140" height="60" as="geometry"/>
