    <mxCell id="out" value="Send result&lt;br&gt;leak / no leak + timings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="nano">
