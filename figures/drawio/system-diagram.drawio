    <mxCell id="ds" value="Leak dataset&lt;br&gt;hydrophone audio&lt;br&gt;8 kHz" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="host">
